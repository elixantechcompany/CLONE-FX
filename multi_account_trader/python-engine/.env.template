# =============================================================================
# VPS Agent — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in every value before running vps_agent.py
# NEVER commit your .env file — it is already in .gitignore
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase  (Project Settings → API)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key


# -----------------------------------------------------------------------------
# MT5 Account Slots  (add up to 5 accounts — leave unused slots blank)
# -----------------------------------------------------------------------------

# Account 1  (required)
MT5_LOGIN_1=12345678
MT5_PASSWORD_1=YourMT5Password1
MT5_SERVER_1=Exness-MT5Real8

# Account 2  (optional)
MT5_LOGIN_2=
MT5_PASSWORD_2=
MT5_SERVER_2=

# Account 3  (optional)
MT5_LOGIN_3=
MT5_PASSWORD_3=
MT5_SERVER_3=

# Account 4  (optional)
MT5_LOGIN_4=
MT5_PASSWORD_4=
MT5_SERVER_4=

# Account 5  (optional)
MT5_LOGIN_5=
MT5_PASSWORD_5=
MT5_SERVER_5=

# Full path to MT5 terminal64.exe  (leave blank to use the default install path)
# Example: MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=


# -----------------------------------------------------------------------------
# Trading Symbol
# -----------------------------------------------------------------------------
MT5_SYMBOL=XAUUSD


# -----------------------------------------------------------------------------
# Risk Management
# -----------------------------------------------------------------------------
# Daily drawdown hard-stop — agent halts + closes all positions when hit
DAILY_LOSS_LIMIT_PCT=3.5

# Risk per trade as % of account equity
RISK_PER_TRADE_PCT=1.0


# -----------------------------------------------------------------------------
# Signal Settings
# -----------------------------------------------------------------------------
# How often (in seconds) the agent scans for new signals
SIGNAL_INTERVAL_SECONDS=60
